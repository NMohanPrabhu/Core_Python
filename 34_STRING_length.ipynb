   "source": [
    "<font color=\"blue\" size=\"6\">find the length of a string without using len():</font>"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "5521655d-3539-4cca-a2ad-69f5f3e0a358",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter a string:  chennai\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Length of string = 7\n"
     ]
    }
   ],
   "source": [
    "def string_length(s):\n",
    "    count = 0\n",
    "    for char in s:\n",
    "        count += 1\n",
    "    return count\n",
    "\n",
    "\n",
    "string = input(\"Enter a string: \")\n",
    "\n",
    "print(\"Length of string =\", string_length(string))\n"
   ]
  },
