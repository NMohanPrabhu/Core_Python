     "text": [
      "Number of digits = 4\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"Enter a number: \"))\n",
    "count = 0\n",
    "while n > 0:\n",
    "    count += 1\n",
    "    n = n // 10\n",
    "print(\"Number of digits =\", count)"
   ]
