   "source": [
    "<font color=\"blue\" size=\"6\">Python program to reverse a number</font>"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "829cd943-f52b-495b-96ca-9344be0cdbf8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter a number:  1234\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Reverse = 4321\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"Enter a number: \"))\n",
    "reverse = 0\n",
    "while n > 0:\n",
    "    digit = n % 10\n",
    "    reverse = reverse * 10 + digit\n",
    "    n = n // 10\n",
    "print(\"Reverse =\", reverse)\n"
   ]
  },
