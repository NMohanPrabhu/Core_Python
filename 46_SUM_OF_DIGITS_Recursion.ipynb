     "text": [
      "Sum of digits = 6\n"
     ]
    }
   ],
   "source": [
    "def sum_digits(n):\n",
    "    if n == 0:\n",
    "        return 0\n",
    "    return (n % 10) + sum_digits(n // 10)\n",
    "num = int(input(\"Enter a number: \"))\n",
    "print(\"Sum of digits =\", sum_digits(num))"
   ]
