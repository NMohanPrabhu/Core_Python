   "source": [
    "<font color=\"blue\" size=\"6\">Sum of digits</font>"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "bc291644-0f11-4e6b-9b37-b577ba4b7ca6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter a number:  1234\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Sum of digits = 10\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"Enter a number: \"))\n",
    "sum = 0\n",
    "while n > 0:\n",
    "    digit = n % 10\n",
    "    sum += digit\n",
    "    n //= 10\n",
    "print(\"Sum of digits =\", sum)"
   ]
  },
