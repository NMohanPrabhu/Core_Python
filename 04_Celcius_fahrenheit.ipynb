   "source": [
    "<font color=\"blue\" size=\"6\"> Python Program to Convert Celsius to Fahrenheit</font>"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "a36a9916-51a5-47bc-8578-e122d2c17aa5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter temperature in Celsius:  102\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Temperature in Fahrenheit = 215.6\n"
     ]
    }
   ],
   "source": [
    "celsius = float(input(\"Enter temperature in Celsius: \"))\n",
    "\n",
    "fahrenheit = (celsius * 9/5) + 32\n",
    "\n",
    "print(\"Temperature in Fahrenheit =\", fahrenheit)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c929d8a8-c572-421c-97b8-ef3760778b33",
   "metadata": {},
   "source": [
    "Formula: Fahrenheit = (Celsius × 9/5) + 32"
   ]
